{
  "name": "zx-engineering-studio",
  "version": "2.11.0",
  "description": "照献工程 - Minecraft Java 1.12.2 世界与建筑编辑器（无 canvas / 无 prismarine-viewer 渲染版）",
  "main": "electron/main.cjs",
  "author": "ZX Engineering",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "mcp": "node mcp/server.mjs",
    "doctor": "node tools/doctor.cjs",
    "test": "node tools/selftest.cjs && node tools/cache-test.cjs && node tools/display-settings-test.cjs && node tools/mcp-install-test.cjs",
    "codex:mcp": "node tools/install-codex-mcp.cjs",
    "pack:win": "electron-builder --win portable",
    "pack:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "minecraft-data": "^3.0.0",
    "prismarine-block": "^1.23.0",
    "prismarine-chunk": "^1.38.1",
    "prismarine-nbt": "^2.7.0",
    "prismarine-provider-anvil": "^2.13.0",
    "prismarine-schematic": "^1.3.0",
    "three": "0.128.0",
    "vec3": "^0.2.0",
    "zod": "^4.1.5"
  },
  "build": {
    "appId": "cn.zx.engineering",
    "productName": "照献工程",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "electron/**/*",
      "build/icon.ico",
      "src/**/*",
      "mcp/**/*",
      "tools/**/*",
      "package.json",
      "README.md",
      "MCP接入说明.md"
    ],
    "win": {
      "signAndEditExecutable": true,
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "照献工程-${version}-Portable.${ext}"
    },
    "portable": {
      "artifactName": "照献工程-${version}-Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.0.12"
  }
}
